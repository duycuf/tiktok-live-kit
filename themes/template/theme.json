{
  "name": "Khung trống",
  "description": "Khung theme trống của TikTok Live Kit: thay ảnh, nhân vật, hiệu ứng, chữ bằng của bạn.",
  "width": 1080,
  "height": 1920,
  "actions": [
    {
      "id": "small",
      "label": "Quà nhỏ",
      "icon": "✨",
      "card": "1 XU",
      "description": "Người tặng sáng lên, lấp lánh, gật đầu",
      "steps": [
        {
          "aura": 1
        },
        {
          "sound": "small"
        },
        {
          "fx": "emit",
          "preset": "spark",
          "at": "head",
          "count": 14
        },
        {
          "play": "nod"
        },
        {
          "fx": "text",
          "at": "head",
          "text": "+{total}"
        }
      ]
    },
    {
      "id": "medium",
      "label": "Quà vừa",
      "icon": "🎉",
      "card": "10 XU",
      "description": "Lên sân khấu, cổ vũ, pháo giấy, rồi về chỗ",
      "steps": [
        {
          "walk": "stage"
        },
        {
          "pose": "stand"
        },
        {
          "sound": "medium"
        },
        {
          "play": "cheer",
          "times": 2
        },
        {
          "fx": "emit",
          "preset": "confetti",
          "at": "head",
          "count": 40
        },
        {
          "walk": "home"
        },
        {
          "pose": "idle"
        }
      ]
    },
    {
      "id": "big",
      "label": "Quà lớn",
      "icon": "🌟",
      "card": "100+ XU",
      "description": "Pháo hoa, pháo lạnh, mưa pháo giấy, cả phòng cổ vũ",
      "steps": [
        {
          "sound": "big"
        },
        {
          "fx": "fireworks",
          "bursts": 5,
          "fountains": 2
        },
        {
          "fx": "rain",
          "preset": "confetti",
          "count": 120
        },
        {
          "crowd": [
            {
              "play": "cheer"
            }
          ]
        }
      ]
    },
    {
      "id": "wave",
      "label": "Vẫy tay",
      "icon": "👋",
      "description": "Dùng cho lệnh chat",
      "steps": [
        {
          "play": "cheer"
        }
      ]
    },
    {
      "id": "draw",
      "label": "Rút thăm",
      "icon": "🎴",
      "description": "Dùng cho lệnh chat rút thăm: lá thăm hiện giữa màn, giọng đọc nội dung",
      "steps": [
        {
          "play": "nod"
        },
        {
          "fx": "emit",
          "preset": "star",
          "at": "head",
          "count": 16
        }
      ]
    }
  ],
  "rules": {
    "joinMode": "all",
    "joinKeywords": [
      "hi",
      "xin chao"
    ],
    "bigGiftCoins": 100,
    "giftTiers": [
      {
        "minCoins": 1,
        "action": "small",
        "label": "Quà nhỏ"
      },
      {
        "minCoins": 10,
        "action": "medium",
        "label": "Quà vừa"
      },
      {
        "minCoins": 100,
        "action": "big",
        "label": "Quà lớn"
      }
    ],
    "giftOverrides": [],
    "chatCommands": [
      {
        "keywords": [
          "hi",
          "hello",
          "chào"
        ],
        "match": "exact",
        "action": "wave",
        "label": "Vẫy tay",
        "cooldownMs": 5000
      },
      {
        "keywords": [
          "rút thăm",
          "rut tham"
        ],
        "match": "contains",
        "action": "draw",
        "label": "Rút thăm",
        "cooldownMs": 3000,
        "draw": "loi-chuc"
      }
